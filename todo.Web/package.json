{
  "name": "todo-web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --open",
    "build": "node tools/build.mjs",
    "build:development": "npm run build -- --configuration development",
    "build:production": "npm run build -- --configuration production",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:e2e": "node e2e/run-e2e.mjs",
    "test:e2e:production": "npm run build && node e2e/run-e2e.mjs --production",
    "test:e2e:install": "playwright install chromium",
    "test:lazy": "npm run build && playwright test --config e2e/lazy-loading.config.ts",
    "check:architecture": "node tools/check-feature-boundaries.mjs",
    "test:architecture": "node --test tools/check-feature-boundaries.spec.mjs",
    "test:deployment": "node --test tools/configure-deployment.spec.mjs tools/build.spec.mjs",
    "prebuild": "npm run check:architecture",
    "pretest": "npm run check:architecture"
  },
  "private": true,
  "packageManager": "npm@10.9.8",
  "dependencies": {
    "@angular/common": "^21.2.25",
    "@angular/compiler": "^21.2.25",
    "@angular/core": "^21.2.25",
    "@angular/forms": "^21.2.25",
    "@angular/platform-browser": "^21.2.25",
    "@angular/router": "^21.2.25",
    "ng-zorro-antd": "^21.3.3",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.26",
    "@angular/cli": "^21.2.26",
    "@angular/compiler-cli": "^21.2.25",
    "@playwright/test": "^1.63.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
